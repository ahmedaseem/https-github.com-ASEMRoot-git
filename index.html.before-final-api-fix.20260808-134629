<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        ASEM Digital Solutions | Global Digital Platform
    </title>

    <link
        rel="canonical"
        href="https://asemdigital.github.io/"
    >

    <link
        rel="icon"
        href="assets/favicon.png"
    >

    <meta
        name="description"
        content="ASEM Digital Solutions — Global digital platform for software solutions, tourism, businesses, products and worldwide services."
    >

    <meta
        name="keywords"
        content="ASEM, Digital Solutions, Global Platform, Software, Web Development, AI, Cloud, Tourism, Businesses, Products"
    >

    <meta
        name="author"
        content="ASEM Digital Solutions"
    >

    <meta
        name="theme-color"
        content="#00aeea"
    >

    <!-- Open Graph -->

    <meta
        property="og:title"
        content="ASEM Digital Solutions"
    >

    <meta
        property="og:description"
        content="A global digital platform connecting technology, tourism, businesses and products."
    >

    <meta
        property="og:type"
        content="website"
    >

    <meta
        property="og:url"
        content="https://asemdigital.github.io/"
    >

    <meta
        property="og:image"
        content="https://asemdigital.github.io/assets/og-image.png"
    >

    <!-- Twitter -->

    <meta
        name="twitter:card"
        content="summary_large_image"
    >

    <meta
        name="twitter:title"
        content="ASEM Digital Solutions"
    >

    <meta
        name="twitter:description"
        content="A global digital platform connecting technology, tourism, businesses and products."
    >

    <meta
        name="twitter:image"
        content="https://asemdigital.github.io/assets/og-image.png"
    >

    <!-- Security -->

    <meta
        http-equiv="Content-Security-Policy"
        content="default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https:;"
    >

    <meta
        http-equiv="Referrer-Policy"
        content="strict-origin-when-cross-origin"
    >

    <link
        rel="preload"
        href="style.css"
        as="style"
    >

    <link
        rel="stylesheet"
        href="style.css"
    >

    <link
        rel="manifest"
        href="manifest.json"
    >

    <!-- Structured Data -->

    <script
        type="application/ld+json"
    >
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "ASEM Digital Solutions",
        "url": "https://asemdigital.github.io/",
        "logo": "https://asemdigital.github.io/assets/og-image.png"
    }
    </script>

</head>


<body>

<!-- =========================================================
     NAVIGATION
     ========================================================= -->

<nav
    class="navbar"
    aria-label="Main Navigation"
>

    <a
        href="index.html"
        class="logo"
        aria-label="ASEM Digital Solutions Home"
    >

        <img
            src="assets/logos/asem-logo.png"
            alt="ASEM Digital Solutions"
        >

    </a>


    <div class="nav-links">

        <a
            href="#global-platform"
            data-i18n="platform"
        >
            Global Platform
        </a>

        <a
            href="#services"
            data-i18n="services"
        >
            Services
        </a>

        <a
            href="#projects"
            data-i18n="projects"
        >
            Projects
        </a>

        <a
            href="#portfolio"
            data-i18n="portfolio"
        >
            Portfolio
        </a>

        <a
            href="about.html"
            data-i18n="about"
        >
            About
        </a>

        <a
            href="contact.html"
            data-i18n="contact"
        >
            Contact
        </a>

    </div>


    <div class="controls">

        <input
            type="search"
            id="searchBox"
            class="search-box"
            placeholder="🔍 Search..."
            aria-label="Search"
            autocomplete="off"
        >


        <select
            id="langSwitch"
            aria-label="Language"
        >

            <option value="auto">
                Auto
            </option>

            <option value="ar">
                العربية
            </option>

            <option value="en">
                English
            </option>

            <option value="fr">
                Français
            </option>

            <option value="ja">
                日本語
            </option>

        </select>


        <button
            id="themeToggle"
            class="theme-toggle"
            type="button"
            aria-label="Toggle Dark Mode"
            title="Toggle Dark Mode"
        >
            🌙
        </button>

    </div>

</nav>


<!-- =========================================================
     HERO
     ========================================================= -->

<header class="hero">

    <h1 data-i18n="hero_title">
        ASEM Digital Solutions
    </h1>


    <p data-i18n="hero_desc">

        Free digital projects and custom software solutions
        for individuals and companies worldwide.

    </p>


    <div class="hero-actions">

        <a
            class="btn"
            href="#projects"
            data-i18n="start_project"
        >
            Start Your Free Project
        </a>


        <a
            class="btn"
            href="contact.html"
            data-i18n="contact"
        >
            Contact Us
        </a>

    </div>

</header>


<!-- =========================================================
     GLOBAL PLATFORM
     ========================================================= -->

<section id="global-platform">

    <h2 data-i18n="global_platform">
        ASEM Global Platform 🌏
    </h2>


    <p data-i18n="global_platform_desc">

        Explore tourism destinations, global businesses,
        products and digital services through one unified platform.

    </p>


    <!-- =====================================================
         PLATFORM ACTION CARDS
         ===================================================== -->

    <div class="cards platform-cards">


        <!-- TOURISM -->

        <button
            type="button"
            class="card platform-card"
            data-platform-action="tourism"
            aria-controls="tourism-section"
            aria-label="Open Global Tourism"
        >

            <span
                class="platform-icon"
                aria-hidden="true"
            >
                🏝️
            </span>


            <h3 data-i18n="tourism">
                Tourism
            </h3>


            <p data-i18n="tourism_desc">

                Discover destinations, attractions
                and experiences around the world.

            </p>

        </button>


        <!-- BUSINESSES -->

        <button
            type="button"
            class="card platform-card"
            data-platform-action="businesses"
            aria-controls="businesses-section"
            aria-label="Open Global Businesses"
        >

            <span
                class="platform-icon"
                aria-hidden="true"
            >
                🌍
            </span>


            <h3 data-i18n="businesses">
                Global Businesses
            </h3>


            <p data-i18n="businesses_desc">

                Explore businesses, restaurants,
                services and organizations worldwide.

            </p>

        </button>


        <!-- PRODUCTS -->

        <button
            type="button"
            class="card platform-card"
            data-platform-action="products"
            aria-controls="products-section"
            aria-label="Open Global Products"
        >

            <span
                class="platform-icon"
                aria-hidden="true"
            >
                🛒
            </span>


            <h3 data-i18n="products">
                Global Products
            </h3>


            <p data-i18n="products_desc">

                Discover products and offerings
                from around the world.

            </p>

        </button>


        <!-- PROJECTS -->

        <button
            type="button"
            class="card platform-card"
            data-platform-action="projects"
            aria-controls="projects"
            aria-label="Open Projects"
        >

            <span
                class="platform-icon"
                aria-hidden="true"
            >
                💻
            </span>


            <h3 data-i18n="projects">
                Projects
            </h3>


            <p>

                Explore ASEM digital projects
                and software solutions.

            </p>

        </button>


        <!-- PORTFOLIO -->

        <button
            type="button"
            class="card platform-card"
            data-platform-action="portfolio"
            aria-controls="portfolio"
            aria-label="Open Portfolio"
        >

            <span
                class="platform-icon"
                aria-hidden="true"
            >
                🗂️
            </span>


            <h3 data-i18n="portfolio">
                Portfolio
            </h3>


            <p>

                Discover selected ASEM
                digital solutions.

            </p>

        </button>


        <!-- SERVICES -->

        <button
            type="button"
            class="card platform-card"
            data-platform-action="services"
            aria-controls="services"
            aria-label="Open Services"
        >

            <span
                class="platform-icon"
                aria-hidden="true"
            >
                ⚙️
            </span>


            <h3 data-i18n="services">
                Services
            </h3>


            <p>

                Explore web development,
                AI, automation and cloud services.

            </p>

        </button>


        <!-- CONTACT -->

        <button
            type="button"
            class="card platform-card"
            data-platform-action="contact"
            aria-label="Open Contact"
        >

            <span
                class="platform-icon"
                aria-hidden="true"
            >
                📩
            </span>


            <h3 data-i18n="contact">
                Contact
            </h3>


            <p>

                Contact ASEM Digital Solutions.

            </p>

        </button>


        <!-- SEARCH -->

        <button
            type="button"
            class="card platform-card"
            data-platform-action="search"
            aria-label="Open Global Search"
        >

            <span
                class="platform-icon"
                aria-hidden="true"
            >
                🔍
            </span>


            <h3 data-i18n="global_search">
                Global Search
            </h3>


            <p>

                Search across the ASEM platform.

            </p>

        </button>

    </div>


    <!-- =====================================================
         TOURISM RESULTS
         ===================================================== -->

    <section
        id="tourism-section"
        class="platform-results"
        aria-labelledby="tourism-title"
        hidden
    >

        <div class="section-header">

            <h2 id="tourism-title">
                🏝️ Global Tourism
            </h2>

            <p>
                Discover destinations and attractions
                around the world.
            </p>

        </div>


        <div
            id="tourismGrid"
            class="cards"
            aria-live="polite"
        ></div>

    </section>


    <!-- =====================================================
         BUSINESSES RESULTS
         ===================================================== -->

    <section
        id="businesses-section"
        class="platform-results"
        aria-labelledby="businesses-title"
        hidden
    >

        <div class="section-header">

            <h2 id="businesses-title">
                🌍 Global Businesses
            </h2>

            <p>
                Explore businesses, restaurants,
                services and organizations worldwide.
            </p>

        </div>


        <div
            id="businessesGrid"
            class="cards"
            aria-live="polite"
        ></div>

    </section>


    <!-- =====================================================
         PRODUCTS RESULTS
         ===================================================== -->

    <section
        id="products-section"
        class="platform-results"
        aria-labelledby="products-title"
        hidden
    >

        <div class="section-header">

            <h2 id="products-title">
                🛒 Global Products
            </h2>

            <p>
                Discover products and offerings
                from around the world.
            </p>

        </div>


        <div
            id="productsGrid"
            class="cards"
            aria-live="polite"
        ></div>

    </section>

</section>


<!-- =========================================================
     SERVICES
     ========================================================= -->

<section id="services">

    <h2 data-i18n="services">
        Our Services
    </h2>


    <div class="cards">


        <article
            class="card"
            tabindex="0"
        >

            <span
                class="platform-icon"
                aria-hidden="true"
            >
                🌐
            </span>

            <h3 data-i18n="web_dev">
                Web Development
            </h3>

            <p data-i18n="web_dev_desc">

                Modern, fast, secure websites
                and digital platforms.

            </p>

        </article>


        <article
            class="card"
            tabindex="0"
        >

            <span
                class="platform-icon"
                aria-hidden="true"
            >
                🤖
            </span>

            <h3 data-i18n="ai_auto">
                AI & Automation
            </h3>

            <p data-i18n="ai_auto_desc">

                Smart solutions powered by modern
                artificial intelligence and automation.

            </p>

        </article>


        <article
            class="card"
            tabindex="0"
        >

            <span
                class="platform-icon"
                aria-hidden="true"
            >
                ☁️
            </span>

            <h3 data-i18n="cloud">
                Cloud Solutions
            </h3>

            <p data-i18n="cloud_desc">

                Scalable and reliable cloud
                infrastructure for modern organizations.

            </p>

        </article>

    </div>

</section>


<!-- =========================================================
     PROJECTS
     ========================================================= -->

<section id="projects">

    <h2 data-i18n="projects">
        Projects
    </h2>


    <p>
        Explore ASEM digital projects and software solutions.
    </p>


    <div
        class="cards"
        id="projectsGrid"
        aria-live="polite"
    ></div>

</section>


<!-- =========================================================
     PORTFOLIO
     ========================================================= -->

<section id="portfolio">

    <h2 data-i18n="portfolio">
        Portfolio
    </h2>


    <p data-i18n="portfolio_desc">

        A selection of our global digital solutions.

    </p>


    <div
        class="portfolio-grid"
        id="portfolioGrid"
        aria-live="polite"
    ></div>

</section>


<!-- =========================================================
     WHY ASEM
     ========================================================= -->

<section id="why">

    <h2 data-i18n="why_asem">
        Why Choose ASEM
    </h2>


    <ul>

        <li data-i18n="secure">
            Enterprise-grade security
        </li>

        <li data-i18n="modern_tech">
            Modern technologies
        </li>

        <li data-i18n="full_solutions">
            Complete digital solutions
        </li>

        <li data-i18n="trusted_world">
            Global digital platform
        </li>

    </ul>

</section>


<!-- =========================================================
     GLOBAL REACH
     ========================================================= -->

<section id="trusted">

    <h2 data-i18n="trusted_world">
        Trusted Worldwide
    </h2>


    <p data-i18n="trusted_desc">

        ASEM is building a global digital ecosystem
        connecting people, businesses, services,
        tourism and technology.

    </p>

</section>


<!-- =========================================================
     PAYMENTS
     ========================================================= -->

<section id="payments">

    <h2 data-i18n="payments">
        Supported Payment Methods
    </h2>


    <div class="payments">


        <img
            src="assets/visa.png"
            loading="lazy"
            alt="Visa"
        >


        <img
            src="assets/mastercard.png"
            loading="lazy"
            alt="Mastercard"
        >


        <img
            src="assets/paypal.png"
            loading="lazy"
            alt="PayPal"
        >


        <img
            src="assets/googlepay.png"
            loading="lazy"
            alt="Google Pay"
        >


        <img
            src="assets/applepay.png"
            loading="lazy"
            alt="Apple Pay"
        >

    </div>

</section>


<!-- =========================================================
     FOOTER
     ========================================================= -->

<footer>

    <div class="social">

        <a
            href="https://github.com/gov-server"
            target="_blank"
            rel="noopener noreferrer"
        >
            GitHub
        </a>


        <a href="#">
            LinkedIn
        </a>


        <a href="#">
            Twitter
        </a>


        <a href="#">
            YouTube
        </a>

    </div>


    <p>
        © 2026 ASEM Digital Solutions
    </p>

</footer>


<!-- =========================================================
     SCROLL TO TOP
     ========================================================= -->

<button
    id="scrollTop"
    type="button"
    aria-label="Scroll to top"
    title="Scroll to top"
    hidden
>
    ↑
</button>


<!-- =========================================================
     APPLICATION
     ========================================================= -->

<script
    src="app.js"
    defer
></script>


</body>

</html>
