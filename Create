"use strict";

require("dotenv").config();

const express = require("express");
const { Pool } = require("pg");
const helmet = require("helmet");
const cors = require("cors");

const app = express();

const pool = new Pool({
    connectionString:
        process.env.DATABASE_URL,

    max: 20,

    idleTimeoutMillis:
        30000,

    connectionTimeoutMillis:
        5000
});


app.use(
    helmet()
);

app.use(
    express.json({
        limit: "1mb"
    })
);

app.use(
    cors({
        origin: true,
        credentials: true
    })
);


/* =========================================================
   GENERIC LIST ENDPOINTS
   ========================================================= */

app.get(
    "/api/tourism",
    async (req, res) => {

        try {

            const result =
                await pool.query(`
                    SELECT
                        id,
                        name,
                        description,
                        category,
                        location,
                        latitude,
                        longitude,
                        image,
                        rating
                    FROM tourism
                    ORDER BY created_at DESC
                    LIMIT 500
                `);

            res.json(result.rows);

        } catch (error) {

            console.error(error);

            res.status(500).json({
                message:
                    "Unable to load tourism."
            });
        }
    }
);


