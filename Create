/* =========================================================
   GLOBAL SEARCH
   ========================================================= */

app.get(
    "/api/search",
    async (req, res) => {

        const q =
            String(
                req.query.q || ""
            ).trim();

        const type =
            String(
                req.query.type || "all"
            );


        if (!q) {

            return res.json([]);
        }


        const search =
            `%${q}%`;


        try {

            const results = [];


            if (
                type === "all" ||
                type === "tourism"
            ) {

                const tourism =
                    await pool.query(
                        `
                        SELECT
                            id,
                            name,
                            description,
                            category,
                            location,
                            latitude,
                            longitude,
                            image,
                            rating,
                            'tourism' AS type
                        FROM tourism
                        WHERE
                            name ILIKE $1
                            OR description ILIKE $1
                            OR category ILIKE $1
                            OR location ILIKE $1
                        ORDER BY
                            similarity(name, $2)
                        DESC
                        LIMIT 50
                        `,
                        [
                            search,
                            q
                        ]
                    );


                results.push(
                    ...tourism.rows
                );
            }


            if (
                type === "all" ||
                type === "businesses"
            ) {

                const businesses =
                    await pool.query(
                        `
                        SELECT
                            id,
                            name,
                            description,
                            category,
                            address,
                            latitude,
                            longitude,
                            logo,
                            cover_image,
                            rating,
                            'business' AS type
                        FROM businesses
                        WHERE
                            name ILIKE $1
                            OR description ILIKE $1
                            OR category ILIKE $1
                            OR address ILIKE $1
                        ORDER BY
                            similarity(name, $2)
                        DESC
                        LIMIT 50
                        `,
                        [
                            search,
                            q
                        ]
                    );


                results.push(
                    ...businesses.rows
                );
            }


            if (
                type === "all" ||
                type === "products"
            ) {

                const products =
                    await pool.query(
                        `
                        SELECT
                            id,
                            name,
                            description,
                            category,
                            price,
                            currency,
                            image,
                            latitude,
                            longitude,
                            'product' AS type
                        FROM products
                        WHERE
                            name ILIKE $1
                            OR description ILIKE $1
                            OR category ILIKE $1
                        ORDER BY
                            similarity(name, $2)
                        DESC
                        LIMIT 50
                        `,
                        [
                            search,
                            q
                        ]
                    );


                results.push(
                    ...products.rows
                );
            }


            if (
                type === "all" ||
                type === "projects"
            ) {

                const projects =
                    await pool.query(
                        `
                        SELECT
                            id,
                            name,
                            description,
                            image,
                            'project' AS type
                        FROM projects
                        WHERE
                            name ILIKE $1
                            OR description ILIKE $1
                        ORDER BY
                            similarity(name, $2)
                        DESC
                        LIMIT 50
                        `,
                        [
                            search,
                            q
                        ]
                    );


                results.push(
                    ...projects.rows
                );
            }


            res.json(results);

        } catch (error) {

            console.error(
                "Search error:",
                error
            );


            res.status(500).json({
                message:
                    "Platform search failed."
            });
        }
    }
);


