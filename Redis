import { Injectable } from '@nestjs/common';
import { InjectQueue } from '@nestjs/bullmq';
import { Queue } from 'bullmq';

@Injectable()
export class LocationQueueService {
  constructor(
    @InjectQueue('location')
    private readonly locationQueue: Queue,
  ) {}

  async addLocationJob(data: Record<string, unknown>) {
    return this.locationQueue.add('process-location', data, {
      attempts: 3,
      backoff: {
        type: 'exponential',
        delay: 1000,
      },
      removeOnComplete: 100,
      removeOnFail: 500,
    });
  }
}
