# ========================================================
# BUSINESS
# ========================================================

def page_business(self):

    self.page_header(
        self.t("business")
    )

    tk.Label(
        self.content,
        text="قسم الأعمال",
        font=("Segoe UI", 18, "bold")
    ).pack(
        pady=30
    )


