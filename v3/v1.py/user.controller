// src/api/v1/users/user.controller.js


const service =
require("./user.service");



exports.getUsers =
async(req,res,next)=>{

try{

const result =
await service.getUsers(
req.query
);


res.json({

success:true,

data:result

});


}catch(e){

next(e);

}

};





exports.getUser =
async(req,res,next)=>{


try{

const user =
await service.getUser(
req.params.id
);


res.json({

success:true,

data:user

});


}catch(e){

next(e);

}

};






exports.updateUser =
async(req,res,next)=>{


try{


const user =
await service.updateUser(

req.params.id,

req.body

);



res.json({

success:true,

data:user

});


}catch(e){

next(e);

}

};






exports.deleteUser =
async(req,res,next)=>{


try{


await service.deleteUser(
req.params.id
);



res.json({

success:true,

message:
"User deleted"

});


}catch(e){

next(e);

}

};
