function openMapForElement(element) {

    const lat =
        Number(element.dataset.lat);

    const lon =
        Number(element.dataset.lon);


    if (
        !Number.isFinite(lat) ||
        !Number.isFinite(lon)
    ) {
        return;
    }


    const url =
        `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
            `${lat},${lon}`
        )}`;


    window.open(
        url,
        "_blank",
        "noopener,noreferrer"
    );
}
